{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Decomps Launcher",
  "version": "0.1.0",
  "identifier": "local.decomps.launcher",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Decomps",
        "width": 1280,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "backgroundColor": "#0b0d12",
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
